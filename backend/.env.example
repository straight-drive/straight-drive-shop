# Copy to .env and fill in real values before running.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string, e.g. from Railway/Render/Supabase/local Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/straight_drive?schema=public"

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Used to build links in emails (verification, password reset) and for CORS
CLIENT_URL=http://localhost:5173

COOKIE_SECRET=change_me_too

# SMTP - leave blank in development to have emails logged to the console instead of sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@straightdrive.com

# Cloudinary - wired in a later phase (product image/video/PDF uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shopify - wired in a later phase (Step 7)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=

# OpenAI - wired in a later phase (Step 8, chatbot)
OPENAI_API_KEY=

# Razorpay - required for checkout (Step 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
